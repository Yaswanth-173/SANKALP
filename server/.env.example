NODE_ENV=development
PORT=5055
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (server.js reads this one now).
# Get it from Atlas -> Database -> Connect -> Drivers. Never commit the
# real value; this placeholder is safe to keep in version control.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sankalp?retryWrites=true&w=majority

# Legacy — the app no longer connects to this. Left here only until
# PostgreSQL removal is explicitly approved; see the migration report.
DATABASE_URL=postgresql://user:password@host:5432/database

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=replace-with-provider-secret
