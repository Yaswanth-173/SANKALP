# Backend
NODE_ENV=production
PORT=5055
CLIENT_URL=https://your-sankalp.vercel.app,http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=replace-with-provider-secret

# Supabase migration/admin configuration (never expose service-role keys to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
